# Copy to .env (never commit .env) or set these in your host's dashboard.
DJANGO_DEBUG=1                      # remove in production
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
GEMINI_API_KEY=                     # from Google AI Studio; empty = extractive mode, no AI calls
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
MIN_BM25_SCORE=1.5                  # keyword gate before calling the model
MIN_EMBED_SIMILARITY=0.62           # embedding gate before calling the model
CHAT_MESSAGES_PER_HOUR=30           # per browser session, protects your API quota
HANDOFF_EMAIL=                      # optional: email each handoff here (needs EMAIL_* below)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
